# Server
PORT=3000
NODE_ENV=development

# Supabase
# Project URL: Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key (SERVER ONLY - never expose to the client / browser / git)
# Dashboard > Project Settings > API Keys > service_role (secret)
SUPABASE_KEY=your-service-role-key

# Comma-separated list of allowed origins for CORS (optional, "*" = allow all)
CORS_ORIGIN=*

# Yemot HaMashiach IVR (type=api)
# Text played to callers (TTS). Avoid . , - & = " ' (they are stripped automatically)
YEMOT_WELCOME_TEXT=שלום וברוכים הבאים
YEMOT_ERROR_TEXT=אירעה שגיאה אנא נסו שוב מאוחר יותר
# Optional shared secret. If set, add to ext.ini: api_add_0=key=<same value>
YEMOT_API_SECRET=
